{
  "name": "quadro-telegram",
  "private": true,
  "version": "1.0.0",
  "description": "«Telegram» — пакет Quadro Hub (quadro.telegram): ИИ владельца читает выбранные им чаты Telegram; клиент MTProto на ПК",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:client": "vite build",
    "build:no-mcp": "node scripts/build.mjs --no-mcp",
    "build:pc": "node scripts/build-pc.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.pc.json",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "1.56.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "telegram": "2.26.22"
  },
  "devDependencies": {
    "@quadrohub/pc-sdk": "https://quadro-metaverse.site/pkg-sdk/v1/pc-sdk-0.1.0.tgz",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
